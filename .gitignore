.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
env/
ENV/
.venv/

# Node / frontend
node_modules/
project/frontend/node_modules/
project/frontend/dist/
project/frontend/dist-electron/
project/frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Electron / build artefacts
project/frontend/.vite/

# Runtime files (legacy file-based storage — now in shared/state.db; kept
# ignored so any leftover or migration-backup copies aren't committed)
shared/inbox/
shared/outbox/
shared/logs/
shared/.secrets.json

# SQLite state (source of truth — local runtime, not committed)
shared/state.db
shared/state.db-wal
shared/state.db-shm
shared/.backup/

# Auto-generated agent context copies (CLI-only; not generated in API mode)
agents/*/CLAUDE.md
agents/*/GEMINI.md
agents/*/AGENTS.md

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# macOS
.DS_Store
